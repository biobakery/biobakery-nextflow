        <mxCell id="join2" value="Merged community profile&#xa;(DNA taxonomy × RNA function)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#27ae60;strokeColor=#1a7a42;fontColor=#ffffff;fontSize=12;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="490" y="510" width="300" height="55" as="geometry" /></mxCell>


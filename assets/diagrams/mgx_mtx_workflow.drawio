        <mxCell id="mtx_qc"  value="QUALITY_CONTROL&#xa;KneadData + rRNA depletion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#333333;fontSize=12;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="875" y="225" width="240" height="50" as="geometry" /></mxCell>
        <mxCell id="mtx_fun" value="FUNCTIONAL_PROFILING&#xa;HUMAnN (RNA transcripts)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#333333;fontSize=12;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="875" y="305" width="240" height="50" as="geometry" /></mxCell>


        <mxCell id="mtx_in" value="MTX FASTQ reads&#xa;(RNA, --mtxdir [planned])" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="125" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- ── MGX arm (left) ── -->
        <mxCell id="mgx_hdr" value="MGX arm" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=14;fontStyle=1;fontColor=#1a6aaa;" vertex="1" parent="1">
          <mxGeometry x="175" y="190" width="250" height="25" as="geometry" />
        </mxCell>

        <mxCell id="mgx_qc"  value="QUALITY_CONTROL&#xa;KneadData" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4a90d9;strokeColor=#1a6aaa;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="175" y="225" width="220" height="50" as="geometry" /></mxCell>
        <mxCell id="mgx_tax" value="TAXONOMIC_PROFILING&#xa;MetaPhlAn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7ab648;strokeColor=#4d8a2a;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="175" y="305" width="220" height="50" as="geometry" /></mxCell>
        <mxCell id="mgx_fun" value="FUNCTIONAL_PROFILING&#xa;HUMAnN (DNA)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8a838;strokeColor=#b07820;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="175" y="385" width="220" height="50" as="geometry" /></mxCell>
        <mxCell id="mgx_vir" value="VIRAL_PROFILING&#xa;BAQLaVa (optional)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c0392b;strokeColor=#922b21;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="175" y="465" width="220" height="50" as="geometry" /></mxCell>


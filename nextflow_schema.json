{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "https://github.com/biobakery/biobakery-nextflow/nextflow_schema.json",
  "title": "bioBakery Nextflow \u2014 DNAnexus MGX pilot",
  "description": "Typed DNAnexus applet interface for the initial whole-metagenome profiling deployment. Samplesheet input is recommended; directory discovery remains available for compatibility.",
  "type": "object",
  "definitions": {
    "input_output_options": {
      "title": "Input and output",
      "type": "object",
      "properties": {
        "workflow": {
          "type": "string",
          "enum": [
            "mgx"
          ],
          "default": "mgx",
          "description": "The initial DNAnexus interface intentionally exposes only the MGX workflow."
        },
        "readsdir": {
          "type": "string",
          "format": "directory-path",
          "description": "Discovery mode: DNAnexus URI for the project folder containing FASTQ files, for example dx://project-id:/inputs/reads. Mutually exclusive with samplesheet."
        },
        "samplesheet": {
          "type": "string",
          "format": "file-path",
          "description": "Samplesheet mode (recommended): CSV with sample, assay, read_1, and read_2 columns. Pass a qualified DNAnexus file reference such as project-id:file-id. Mutually exclusive with readsdir."
        },
        "outdir": {
          "type": "string",
          "default": "results",
          "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*://).+$",
          "description": "Relative publication folder beneath the DNAnexus job destination. Absolute paths and URIs are not allowed."
        },
        "input_metadata": {
          "type": "string",
          "format": "file-path",
          "description": "Optional study metadata file used only when reporting stages are enabled later."
        }
      },
      "oneOf": [
        {
          "required": [
            "readsdir"
          ],
          "not": {
            "required": [
              "samplesheet"
            ]
          }
        },
        {
          "required": [
            "samplesheet"
          ],
          "not": {
            "required": [
              "readsdir"
            ]
          }
        }
      ]
    },
    "container_options": {
      "title": "Container",
      "type": "object",
      "properties": {
        "dnanexus_container": {
          "type": "string",
          "minLength": 1,
          "description": "Immutable database-bearing KneadData Docker tarball reference. A bare file ID is resolved in the running DNAnexus project; use dx://project-id:file-id for another project."
        }
      },
      "required": [
        "dnanexus_container"
      ]
    },
    "library_options": {
      "title": "Read layout",
      "type": "object",
      "properties": {
        "paired_end": {
          "type": "boolean",
          "default": true,
          "description": "Allow paired-end detection from read filenames."
        },
        "single_end": {
          "type": "boolean",
          "default": false,
          "description": "Force all reads to be processed as single-end."
        },
        "pair_identifier": {
          "type": "string",
          "default": "_R{1,2}",
          "description": "Filename token used to identify read mates."
        },
        "filepattern": {
          "type": "string",
          "description": "Optional FASTQ glob overriding pair_identifier."
        },
        "filepattern_single": {
          "type": "string",
          "default": "*.fastq.gz",
          "description": "FASTQ glob used for single-end input."
        }
      }
    },
    "stage_options": {
      "title": "Pipeline stages",
      "type": "object",
      "properties": {
        "run_qc": {
          "type": "boolean",
          "default": true,
          "description": "Run KneadData quality control and host depletion."
        },
        "run_taxonomic_profiling": {
          "type": "boolean",
          "default": false,
          "description": "Disabled for the KneadData-only DNAnexus slice."
        },
        "run_functional_profiling": {
          "type": "boolean",
          "default": false,
          "description": "Disabled for the KneadData-only DNAnexus slice."
        },
        "stop_after_qc": {
          "type": "boolean",
          "default": true,
          "description": "Wait for every KneadData task and the aggregate read-count table, then fail intentionally before later stages."
        },
        "run_vis": {
          "type": "boolean",
          "default": false,
          "description": "Disabled for the first DNAnexus slice; visualization container coverage is pending."
        },
        "run_stats": {
          "type": "boolean",
          "default": false,
          "description": "Disabled for the first DNAnexus slice; statistics container coverage is pending."
        },
        "run_strain_profiling": {
          "type": "boolean",
          "default": false,
          "description": "Disabled for the first DNAnexus slice."
        },
        "run_viral_profiling": {
          "type": "boolean",
          "default": false,
          "description": "Disabled for the first DNAnexus slice."
        }
      }
    },
    "database_options": {
      "title": "Reference databases",
      "type": "object",
      "properties": {
        "host_genome": {
          "type": "string",
          "format": "directory-path",
          "description": "KneadData host reference database directory. With the DNAnexus profile, this is the absolute path baked into the KneadData container image. Required when run_qc is true."
        },
        "kneaddata_database_identity": {
          "type": "string",
          "description": "Optional semantic database identity included in the task command and resume hash. When omitted, the immutable DNAnexus container URI is used."
        },
        "metaphlan_db": {
          "type": "string",
          "format": "directory-path",
          "description": "MetaPhlAn database directory. Required when taxonomic profiling is enabled."
        },
        "metaphlan_index": {
          "type": "string",
          "default": "mpa_vJun23_CHOCOPhlAnSGB_202307",
          "description": "Exact MetaPhlAn database index identifier."
        },
        "humann_db_chocophlan": {
          "type": "string",
          "format": "directory-path",
          "description": "Exact HUMAnN nucleotide database directory."
        },
        "humann_db_utilitymapping": {
          "type": "string",
          "format": "directory-path",
          "description": "Exact HUMAnN utility mapping directory (HUMAnN 4)."
        },
        "humann_db_protein": {
          "type": "string",
          "format": "directory-path",
          "description": "Exact HUMAnN protein database directory."
        },
        "metaphlan_db_root": {
          "type": "string",
          "format": "directory-path",
          "description": "Site base path for relative metaphlan_db entries selected in the run parameters."
        }
      }
    },
    "tool_options": {
      "title": "Tool contracts",
      "type": "object",
      "properties": {
        "metaphlan_version": {
          "type": "string",
          "enum": [
            "metaphlan_v3",
            "metaphlan_v4",
            "metaphlan_4.0.6_fixed"
          ],
          "default": "metaphlan_v4",
          "description": "MetaPhlAn command-line contract selector."
        },
        "metaphlan_analysis_type": {
          "type": "string",
          "enum": [
            "rel_ab",
            "rel_ab_w_read_stats",
            "marker_ab_table"
          ],
          "default": "rel_ab_w_read_stats"
        },
        "metaphlan_read_min_len": {
          "type": "integer",
          "minimum": 1,
          "default": 70
        },
        "humann_version": {
          "type": "string",
          "enum": [
            "humann_v37",
            "humann_v4a"
          ],
          "default": "humann_v37",
          "description": "HUMAnN command-line contract selector."
        },
        "humann_bypass_prescreen": {
          "type": "boolean",
          "default": false
        },
        "humann_bypass_nucleotide_search": {
          "type": "boolean",
          "default": false
        },
        "run_humann_regroup": {
          "type": "boolean",
          "default": true
        },
        "run_humann_rename": {
          "type": "boolean",
          "default": true
        },
        "run_humann_merge": {
          "type": "boolean",
          "default": true
        },
        "kneaddata_bypass_trim": {
          "type": "boolean",
          "default": false
        },
        "kneaddata_remove_intermediate_files": {
          "type": "boolean",
          "default": true
        },
        "humann_regroups": {
          "type": "array",
          "description": "Independent HUMAnN mappings; [] disables regrouping. Rename is optional for each mapping.",
          "default": [
            {
              "output_label": "rxn",
              "groups": "uniref90_rxn",
              "rename": "metacyc-rxn"
            }
          ],
          "items": {
            "type": "object",
            "required": [
              "output_label"
            ],
            "additionalProperties": false,
            "properties": {
              "output_label": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
                "description": "Unique label used in output filenames and folders (for example ecs, kos, pfams)."
              },
              "groups": {
                "type": "string",
                "minLength": 1
              },
              "group_mapping_database": {
                "type": "string",
                "format": "file-path",
                "description": "Explicit mapping file supplied to humann_regroup_table --custom."
              },
              "rename": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "renaming_database": {
                "type": "string",
                "format": "file-path",
                "description": "Optional name mapping file supplied to humann_rename_table --custom."
              },
              "database_location": {
                "type": "string",
                "enum": [
                  "host",
                  "container"
                ],
                "description": "Optional per-mapping override of humann_db_location."
              }
            },
            "oneOf": [
              {
                "required": [
                  "groups"
                ],
                "not": {
                  "required": [
                    "group_mapping_database"
                  ]
                }
              },
              {
                "required": [
                  "group_mapping_database"
                ],
                "not": {
                  "required": [
                    "groups"
                  ]
                }
              }
            ],
            "allOf": [
              {
                "not": {
                  "required": [
                    "rename",
                    "renaming_database"
                  ],
                  "properties": {
                    "rename": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            ]
          }
        },
        "humann_db_location": {
          "type": "string",
          "enum": [
            "host",
            "container"
          ],
          "default": "host",
          "description": "Location of humann reference paths: staged host inputs or paths inside the task runtime."
        },
        "kneaddata_db_location": {
          "type": "string",
          "enum": [
            "host",
            "container"
          ],
          "default": "host",
          "description": "Location of kneaddata reference paths: staged host inputs or paths inside the task runtime."
        },
        "metaphlan_db_location": {
          "type": "string",
          "enum": [
            "host",
            "container"
          ],
          "default": "host",
          "description": "Location of metaphlan reference paths: staged host inputs or paths inside the task runtime."
        },
        "strainphlan_db_location": {
          "type": "string",
          "enum": [
            "host",
            "container"
          ],
          "default": "host",
          "description": "Location of strainphlan reference paths: staged host inputs or paths inside the task runtime."
        },
        "baqlava_db_location": {
          "type": "string",
          "enum": [
            "host",
            "container"
          ],
          "default": "host",
          "description": "Location of baqlava reference paths: staged host inputs or paths inside the task runtime."
        },
        "phylophlan_db_location": {
          "type": "string",
          "enum": [
            "host",
            "container"
          ],
          "default": "host",
          "description": "Location of phylophlan reference paths: staged host inputs or paths inside the task runtime."
        },
        "checkm2_db_location": {
          "type": "string",
          "enum": [
            "host",
            "container"
          ],
          "default": "host",
          "description": "Location of checkm2 reference paths: staged host inputs or paths inside the task runtime."
        },
        "checkm2_db": {
          "type": "string",
          "description": "Optional explicit CheckM2 database file; omit to use the tool environment default."
        }
      }
    },
    "provenance_options": {
      "title": "Provenance",
      "type": "object",
      "properties": {
        "log_versions": {
          "type": "boolean",
          "default": true,
          "description": "Record observed tool versions and run parameters."
        }
      }
    },
    "resource_options": {
      "title": "Resource ceilings",
      "type": "object",
      "properties": {
        "max_memory": {
          "type": "string",
          "default": "128.GB",
          "pattern": "^[1-9][0-9]*(\\.[0-9]+)?\\s*(KB|MB|GB|TB)$"
        },
        "max_cpus": {
          "type": "integer",
          "minimum": 1,
          "default": 32
        },
        "max_time": {
          "type": "string",
          "default": "240.h",
          "pattern": "^[1-9][0-9]*(\\.[0-9]+)?\\s*(ms|s|m|h|d)$"
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/definitions/input_output_options"
    },
    {
      "$ref": "#/definitions/container_options"
    },
    {
      "$ref": "#/definitions/library_options"
    },
    {
      "$ref": "#/definitions/stage_options"
    },
    {
      "$ref": "#/definitions/database_options"
    },
    {
      "$ref": "#/definitions/tool_options"
    },
    {
      "$ref": "#/definitions/provenance_options"
    },
    {
      "$ref": "#/definitions/resource_options"
    }
  ]
}

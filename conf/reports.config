// ─────────────────────────────────────────────────────────────────────────────
// RUNTIME — what Nextflow records about this run.
//
// These are not pipeline parameters: nothing here changes what the workflow
// computes, only what is written alongside it. Everything lands in
// <outdir>/pipeline_info/ and is stamped with the launch time, so a -resume or
// a second run into the same outdir adds a file rather than overwriting one.
//
// Turn any of them off on the command line for a throwaway run, e.g.
//   nextflow run main.nf ... -without-dag
// ─────────────────────────────────────────────────────────────────────────────

def run_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
def info_dir      = "${params.outdir}/pipeline_info"

// Per-task CPU and memory over time — the file to read when sizing a process.
timeline {
    enabled   = true
    overwrite = true
    file      = "${info_dir}/execution_timeline_${run_timestamp}.html"
}

// Human-readable run summary: every task, its resources and its exit status.
report {
    enabled   = true
    overwrite = true
    file      = "${info_dir}/execution_report_${run_timestamp}.html"
}

// The same data as a TSV, for scripting resource requests.
trace {
    enabled   = true
    overwrite = true
    file      = "${info_dir}/execution_trace_${run_timestamp}.txt"
    fields    = 'task_id,hash,name,status,exit,realtime,cpus,memory,disk,rss,vmem,peak_rss,peak_vmem'
}

// The graph of this particular run. The committed diagrams in docs/diagrams/
// are the same renderer driven by bin/make_diagrams.py, which uses -preview so
// it needs no tools; this one reflects the toggles the run actually used.
dag {
    enabled   = true
    overwrite = true
    file      = "${info_dir}/pipeline_dag_${run_timestamp}.html"
}

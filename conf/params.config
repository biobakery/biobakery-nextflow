// ─────────────────────────────────────────────────────────────────────────────
// GLOBAL DEFAULTS — the default value of every pipeline parameter.
//
// This file is the single place a parameter is declared, and nothing in it is
// site-specific or run-specific:
//
//   * site defaults (database paths, tool modules, executor) live in
//     conf/databases/<site>.config and conf/profiles/<site>.config, and are
//     selected with -profile;
//   * the settings for one run go in a params file (conf/harvard_rc.yaml,
//     conf/tufts_hpc.yaml) or on the command line.
//
// Both override what is here. See the precedence list in nextflow.config.
//
// Three values have no usable default and must come from a profile or the
// command line: readsdir (or the two mgx_mtx input folders), host_genome and
// the tool databases. Everything else runs as it stands.
// ─────────────────────────────────────────────────────────────────────────────

params {

    // ── Workflow selector ──────────────────────────────────────────────────
    // mgx | mtx | mgx_mtx | 16s | vis | stats | assembly
    workflow = 'mgx'

    // ── Input / output ─────────────────────────────────────────────────────
    readsdir     = null                     // REQUIRED for mgx, mtx, 16s, assembly
    samplesheet  = null                     // alternative to readsdir for read-based workflows
    outdir       = 'results'

    // mgx_mtx takes two input folders rather than one, and an optional file
    // mapping each metatranscriptome sample to its metagenome sample.
    // Tab-delimited, "#" comments allowed, one "<rna sample>\t<dna sample>"
    // per line. With a mapping, the RNA samples reuse the DNA sample's
    // MetaPhlAn profile instead of being profiled themselves.
    input_metagenome        = null           // REQUIRED for mgx_mtx
    input_metatranscriptome = null           // REQUIRED for mgx_mtx
    input_mapping           = null

    // ── Library layout ─────────────────────────────────────────────────────
    // Detected from the read filenames: if the pair identifier is never found
    // the run falls back to single-end with a warning. Set single_end = true
    // (or paired_end = false) to force single-end even when pairs exist.
    paired_end       = true
    single_end       = false
    // The paired-end glob is built from this as "*<pair_identifier>*.fastq.gz",
    // so there is one place to change the mate naming convention. Set
    // filepattern to override the glob outright.
    pair_identifier  = '_R{1,2}'
    filepattern        = null
    filepattern_single = '*.fastq.gz'

    // ── Stage toggles ──────────────────────────────────────────────────────
    run_qc                   = true
    // Development gate: wait for the complete QC aggregate, then fail on
    // purpose instead of scheduling later stages. Site profiles may enable
    // this while bringing up a new runtime; normal profiles leave it off.
    stop_after_qc            = false
    run_taxonomic_profiling  = true
    run_functional_profiling = true
    run_strain_profiling     = false  // StrainPhlAn (SGB mode)
    run_viral_profiling      = false  // BAQLaVa viral profiling
    // mgx_mtx only: skip the RNA/DNA relative expression ratio
    bypass_norm_ratio        = false

    // ── QC options (KneadData) ─────────────────────────────────────────────
    kneaddata_bypass_trim               = false
    kneaddata_remove_intermediate_files = true
    // staged: ordinary Nextflow path inputs. dxfuse: a site profile creates
    // the task-local `kneaddata_reference` path. Only DNAnexus enables it.
    kneaddata_reference_mode            = 'staged'
    kneaddata_database_identity         = null

    // ── Taxonomic profiling options (MetaPhlAn) ────────────────────────────
    metaphlan_version        = 'metaphlan_v4'  // metaphlan_v3 | metaphlan_v4 | metaphlan_4.0.6_fixed
    metaphlan_analysis_type  = 'rel_ab_w_read_stats'  // rel_ab | rel_ab_w_read_stats | marker_ab_table
    metaphlan_read_min_len   = 70

    // ── Functional profiling options (HUMAnN) ─────────────────────────────
    humann_version                  = 'humann_v37'  // humann_v37 | humann_v4a
    humann_bypass_prescreen         = false
    humann_bypass_nucleotide_search = false
    run_humann_regroup              = true
    run_humann_rename               = true
    run_humann_merge                = true
    humann_regroup_grouping         = 'uniref90_rxn'  // uniref90_rxn | uniref90_ko | uniref90_eggnog | uniref90_pfam
    // humann_rename_table takes a different vocabulary to humann_regroup_table;
    // leave null to map from humann_regroup_grouping automatically
    humann_rename_names             = null  // kegg-orthology | ec | metacyc-rxn | metacyc-pwy | pfam | eggnog | go | infogo1000 | uniref90

    // ── Viral profiling options (BAQLaVa) ──────────────────────────────────
    baqlava_bypass_depletion = false  // set true for test samples with 0 prescreen species

    // ── Strain profiling options (StrainPhlAn) ────────────────────────────
    strainphlan_clades              = null         // null = all detected; or comma-separated list
    strainphlan_phylophlan_mode     = 'accurate'   // accurate | fast
    strainphlan_marker_in_n_samples = 2

    // ── Assembly options (MAG assembly + binning + SGB clustering) ────────
    megahit_min_contig_length       = 2500
    sgb_completeness                = 50            // minimum MAG completeness %
    sgb_contamination               = 10            // maximum MAG contamination %
    sgb_abundance_type              = 'by_sample'   // by_sample | by_dataset

    // ── Per-tool extra arguments ───────────────────────────────────────────
    // Appended verbatim to that tool's command line. Mirrors the anadama2
    // workflow's "--<tool>-options" parameters, and avoids having to surface
    // every flag each tool supports as its own param.
    kneaddata_options               = ''
    metaphlan_options               = ''
    humann_options                  = ''
    baqlava_options                 = ''
    strainphlan_options             = ''
    megahit_options                 = ''
    metabat_options                 = ''
    checkm_predict_options          = ''
    checkm_coverage_options         = ''
    phylophlan_metagenomic_options  = ''
    mash_sketch_options             = ''
    maaslin_options                 = ''
    halla_options                   = ''

    // ── Database paths ─────────────────────────────────────────────────────
    // No defaults: a database path is a property of the machine, not of the
    // pipeline. -profile harvard_rc / tufts_hpc sets these; otherwise pass them.
    host_genome        = null   // REQUIRED whenever run_qc is true
    // Metatranscriptome QC only (mtx, and the mtx half of mgx_mtx): host mRNA
    // and rRNA are removed in addition to the host genome.
    host_transcriptome = null
    rrna_db            = null
    metaphlan_db       = null   // REQUIRED whenever run_taxonomic_profiling is true
    metaphlan_index    = 'mpa_vJun23_CHOCOPhlAnSGB_202307'
    humann_db          = null   // REQUIRED whenever run_functional_profiling is true
    strainphlan_db     = null   // auto-resolved from metaphlan_db when null
    baqlava_db         = null   // uses the bundled database when null
    phylophlan_path    = null   // REQUIRED for the assembly workflow only

    // ── Reports (vis / stats) ──────────────────────────────────────────────
    // Both consume a folder of bioBakery output, like
    // `biobakery_workflows vis|stats` does, and are run standalone with
    // --workflow vis|stats.
    //
    // vis also runs at the end of a read-based workflow (mgx, mtx, mgx_mtx), on
    // a bioBakery-standard folder built from that run's own output channels.
    //
    // stats does not, by default. It is a study-level analysis, not a report:
    // it needs metadata, fixed effects, and enough samples for MaAsLin2, HAllA
    // and the mantel test to have anything to fit -- on a handful of samples
    // they fail, and a chained failure would take down an otherwise complete
    // profiling run at the last step. Turn it on deliberately with
    // --run_stats true (plus --input_metadata), or run --workflow stats
    // separately, which is what biobakery_workflows does in any case.
    run_vis   = true
    run_stats = false

    // Input folders; default to the run's own output folder when chained
    vis_input   = null
    stats_input = null

    // stats requires metadata; vis uses it when provided
    input_metadata = null
    // extra file type hints, semicolon-delimited "filename,filetype" pairs
    input_file_type = null

    // Report presentation
    project_name      = ''
    author_name       = ''
    header_image      = ''
    introduction_text = ''
    use_template      = null
    // AnADAMA defaults to pdf; html avoids the pdflatex dependency at render time
    report_format     = 'html'

    // Metadata handling, shared by vis and stats
    metadata_categorical = ''   // comma-delimited
    metadata_continuous  = ''   // comma-delimited
    metadata_exclude     = ''   // comma-delimited
    max_missing          = 20.0

    // ── vis options ────────────────────────────────────────────────────────
    vis_min_abundance         = 0.01
    vis_min_samples           = 3
    vis_max_sets_heatmap      = 25
    vis_max_sets_barplot      = 15
    vis_max_groups_barplot    = 5
    vis_correlation_threshold = 0.7
    input_picard              = null
    input_picard_extension    = 'quality_by_cycle_metrics'

    // ── stats options ──────────────────────────────────────────────────────
    stats_transform                   = ''
    stats_adonis_method               = 'bray'
    stats_fixed_effects               = ''
    stats_multivariable_fixed_effects = ''
    // setting random effects makes the study longitudinal, which runs the
    // PERMANOVA instead of beta diversity and requires static covariates
    stats_random_effects              = ''
    stats_static_covariates           = ''
    stats_bypass_maaslin              = false
    stats_bypass_halla                = false
    stats_permutations                = 4999
    stats_scale                       = 100
    stats_min_abundance               = 0.0001
    stats_min_prevalence              = 0.1
    stats_top_pathways                = 3

    // ── Version logging ────────────────────────────────────────────────────
    log_versions = true

    // ── Resource ceilings ──────────────────────────────────────────────────
    // No process is given more than this, however a profile scales it on retry.
    // Set these to the largest node you can actually be scheduled on.
    max_memory = '128.GB'
    max_cpus   = 32
    max_time   = '240.h'

    // DNAnexus profile only. Supply either an immutable registry reference or
    // a DNAnexus Docker tarball URI (dx://project-id:file-id). There is no
    // default because the repository does not yet publish a canonical image.
    dnanexus_container = null
}

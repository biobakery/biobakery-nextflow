// ─────────────────────────────────────────────────────────────────────────────
// DEFAULT RESOURCES — what each process asks for, on any machine.
//
// These are the pipeline's own figures, sized from the execution traces of real
// runs, and they are what a site profile starts from. A profile should override
// a value here only when that machine genuinely differs (a smaller partition, a
// cheaper filesystem), and should say why; if a number is simply wrong, fix it
// here so every site gets the fix.
//
// Every request is `<figure> * task.attempt`, so a task that was killed for
// running out of memory or time gets more of it on retry, up to two retries.
// check_max() then caps the result at params.max_memory / max_cpus / max_time,
// which is the one place to set what this cluster can actually schedule.
// ─────────────────────────────────────────────────────────────────────────────

process {

    // Anything not named below: a small script over a few text files.
    cpus   = { check_max(2    * task.attempt, 'cpus')   }
    memory = { check_max(4.GB * task.attempt, 'memory') }
    time   = { check_max(4.h  * task.attempt, 'time')   }

    // 125 is how SLURM reports OUT_OF_MEMORY; 137/143 are SIGKILL/SIGTERM,
    // which is what a cgroup OOM or a time limit looks like from inside.
    errorStrategy = { task.exitStatus in [125,143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    // ── Read-based profiling ───────────────────────────────────────────────
    withName: 'single_end_kneaddata|paired_end_kneaddata' {
        cpus   = { check_max(8     * task.attempt, 'cpus')   }
        memory = { check_max(16.GB * task.attempt, 'memory') }
        time   = { check_max(8.h   * task.attempt, 'time')   }
    }

    withName: metaphlan {
        cpus   = { check_max(8     * task.attempt, 'cpus')   }
        memory = { check_max(32.GB * task.attempt, 'memory') }
        time   = { check_max(4.h   * task.attempt, 'time')   }
    }

    withName: humann {
        cpus   = { check_max(16    * task.attempt, 'cpus')   }
        memory = { check_max(32.GB * task.attempt, 'memory') }
        time   = { check_max(12.h  * task.attempt, 'time')   }
    }

    withName: baqlava {
        cpus   = { check_max(4     * task.attempt, 'cpus')   }
        memory = { check_max(16.GB * task.attempt, 'memory') }
        time   = { check_max(8.h   * task.attempt, 'time')   }
    }

    withName: 'sample2markers|strainphlan' {
        cpus   = { check_max(8     * task.attempt, 'cpus')   }
        memory = { check_max(16.GB * task.attempt, 'memory') }
        time   = { check_max(8.h   * task.attempt, 'time')   }
    }

    // Per-sample HUMAnN table manipulation and the joins across samples.
    withName: 'humann_regroup|humann_regroup_ecs|humann_rename|humann_renorm|humann_join|humann_join_relab|humann_count_features|humann_feature_counts_merge|rna_dna_norm' {
        cpus   = 2
        memory = { check_max(16.GB * task.attempt, 'memory') }
        time   = { check_max(2.h   * task.attempt, 'time')   }
    }

    // ── Assembly (MAG/SGB) ─────────────────────────────────────────────────
    withName: megahit {
        cpus   = { check_max(16    * task.attempt, 'cpus')   }
        memory = { check_max(64.GB * task.attempt, 'memory') }
        time   = { check_max(24.h  * task.attempt, 'time')   }
    }

    // align_and_depth is bowtie2 + samtools; abundance re-indexes that BAM and
    // runs CheckM coverage over the sample's bins, so they size together.
    withName: 'align_and_depth|abundance' {
        cpus   = { check_max(8     * task.attempt, 'cpus')   }
        memory = { check_max(32.GB * task.attempt, 'memory') }
        time   = { check_max(12.h  * task.attempt, 'time')   }
    }

    withName: 'metabat2|checkm2' {
        cpus   = { check_max(8     * task.attempt, 'cpus')   }
        memory = { check_max(32.GB * task.attempt, 'memory') }
        time   = { check_max(8.h   * task.attempt, 'time')   }
    }

    withName: phylophlan_metagenomic {
        // Reads the full SGB sketch database, so give it room and time.
        cpus   = { check_max(16    * task.attempt, 'cpus')   }
        memory = { check_max(64.GB * task.attempt, 'memory') }
        time   = { check_max(24.h  * task.attempt, 'time')   }
    }

    // The tables and clustering around those tools: MAG-count sized, not
    // read-count sized, so none of them needs an assembly-scale allocation.
    withName: 'checkm2_merge|checkm2_wrangling|mag_n50|phylophlan_merge|mash_list_inputs|mash_sketch|mash_paste|mash_dist|sgb_cluster|merge_tax_abundance' {
        cpus   = { check_max(4     * task.attempt, 'cpus')   }
        memory = { check_max(16.GB * task.attempt, 'memory') }
        time   = { check_max(4.h   * task.attempt, 'time')   }
    }

    // ── vis / stats reports ────────────────────────────────────────────────
    withName: 'identify_inputs|feature_table|trim_taxonomy|add_ec_names|covariate_equation|stratified_metadata|halla_transpose_metadata|archive_output' {
        cpus   = 1
        memory = { check_max(8.GB * task.attempt, 'memory') }
        time   = { check_max(1.h  * task.attempt, 'time')   }
    }

    withName: 'alpha_diversity|mantel_test|maaslin2|beta_diversity|permanova|stratified_barplot' {
        cpus   = 2
        memory = { check_max(16.GB * task.attempt, 'memory') }
        time   = { check_max(2.h   * task.attempt, 'time')   }
    }

    withName: halla {
        cpus   = { check_max(4     * task.attempt, 'cpus')   }
        memory = { check_max(16.GB * task.attempt, 'memory') }
        time   = { check_max(4.h   * task.attempt, 'time')   }
    }

    withName: 'vis_report|stats_report' {
        // pweave renders every figure in one process, so the report is the one
        // heavy step of either workflow.
        cpus   = 4
        memory = { check_max(32.GB * task.attempt, 'memory') }
        time   = { check_max(6.h   * task.attempt, 'time')   }
    }

    // ── Bookkeeping ────────────────────────────────────────────────────────
    // Small table and folder assembly: a script over a few text files.
    withName: 'kneaddata_read_counts|metaphlan_bzip|metaphlan_merge|metaphlan_species_counts|humann_log_counts|stage_report_input|merge_report_input|merge_pairs' {
        cpus   = 1
        memory = { check_max(8.GB * task.attempt, 'memory') }
        time   = { check_max(1.h  * task.attempt, 'time')   }
    }

    withName: version_log {
        cpus   = 1
        memory = '1.GB'
        time   = '10.m'
    }

    // A chained report is an extra on top of a profiling run, so its failure is
    // not the run's failure: the profiles and tables are already written and
    // published. vis and stats legitimately fail on a study too small or too
    // sparse to visualise -- an ordination of two samples, a heatmap of a
    // handful of features -- and losing a complete run at its last step over
    // that is the wrong trade. The failure is still reported in the log.
    //
    // Standalone `--workflow vis|stats` runs carry no REPORTING prefix and are
    // unaffected: there the report *is* the run, and a failure should fail.
    withName: '.*:REPORTING:.*' {
        errorStrategy = 'ignore'
    }
}

// Cap a resource request at the ceiling in params.max_*, so a retry that keeps
// doubling cannot ask for more than the cluster can schedule.
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else return obj
        } catch (all) { return obj }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else return obj
        } catch (all) { return obj }
    } else if (type == 'cpus') {
        try { return Math.min(obj as int, params.max_cpus as int) }
        catch (all) { return obj }
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// SITE RUNTIME — Harvard FASRC (Cannon), SLURM + hutlab modules.
//
// This file answers one question per process: which software environment does
// it run in. Resource requests belong to conf/base.config, and only the ones
// FASRC genuinely needs differently are repeated here, each with its reason.
// Database paths are in conf/databases/harvard_rc.config.
//
// TWO RULES, because of how Nextflow merges a profile into an included config:
// a `withName:` block in a profile *replaces* the block base.config gives the
// same selector string -- it does not merge into it. So a block here that set
// only `beforeScript` silently deleted that process's cpus, memory and time,
// which is how every read-based test came to be OOM-killed at the 4 GB default.
//   1. Environment only, no resource reason: use a selector string base.config
//      does not also use, so its block still applies. Two one-process blocks
//      instead of one grouped block is enough, and costs nothing.
//   2. A real resource override: the block must restate cpus, memory and time
//      in full, since base.config's are gone. Keep the `* task.attempt` form so
//      a retry still escalates. check_max() is a `def` local to base.config and
//      is not in scope here, so these are uncapped by params.max_*; the figures
//      below are already within what hsph schedules.
// bin/check_profile_resources.py enforces both, and CI runs it.
//
// Every process takes its environment from a `beforeScript` rather than from a
// module loaded at submit time, because the processes do not share one stack:
// HAllA and biobakery_workflows/3.2 cannot both be loaded (see `halla` below),
// and the report steps need R and pweave that the profiling steps do not.
//
// Load the pipeline itself with:
//   source /n/lab_storage/huttenhower_lab/tools/hutlab/src/hutlabrc_rocky8.sh
//   hutlab load rocky8/biobakery-workflows-nextflow/0.0.4
// ─────────────────────────────────────────────────────────────────────────────

// One definition of where the hutlab modules live and of each tool stack, so a
// module version is changed in one line rather than in seventeen beforeScripts.
// See docs/dependencies.md for what each stack provides.
def hutlab   = 'module use /n/lab_storage/huttenhower_lab/tools/hutlab/src/modules_rocky8'
def base     = "${hutlab}; module load python/3.10.9-fasrc01"
def base_gcc = "${base}; module load gcc/9.5.0-fasrc01"

// KneadData 0.12.0. Also provides kneaddata_read_count_table.
def env_kneaddata  = "${base}; module load rocky8/kneaddata/0.12.0-devel"

// MetaPhlAn 4.0.6_vOct22_fixed — mpa_vOct22_CHOCOPhlAnSGB_202403, the build
// HUMAnN 4 and BAQLaVa 1.2.0 are compatible with. Also provides
// merge_metaphlan_tables.py.
def env_metaphlan  = "${base_gcc}; module load rocky8/metaphlan4/4.0.6_vOct22_fixed"

// HUMAnN 4.0-alpha-1-final. Auto-loads metaphlan4/4.0.6_vOct22_fixed.
def env_humann     = "${base_gcc}; module load rocky8/humann4/4.0-alpha-1-final"

// BAQLaVa 1.2.0-devel. Auto-loads humann4, anadama2 and metaphlan4.
def env_baqlava    = "${base_gcc}; module load rocky8/baqlava/1.2.0-devel"

// biobakery_workflows 3.2, the stack the anadama2 workflows themselves use.
// Three groups of processes need it:
//   * the assembly tools — megahit, bowtie2, samtools, metabat2,
//     jgi_summarize_bam_contig_depths, checkm2, phylophlan, mash, fastANI,
//     assembly-stats — plus the CHECKM2DB and PHYLOPHLAN_PATH variables. One
//     module keeps the nextflow assembly workflow on exactly the same stack as
//     `biobakery_workflows assembly`;
//   * the scripts that ship with biobakery_workflows rather than with a tool:
//     count_features.py, rna_dna_norm.py, get_counts_from_humann_logs.py,
//     humann_join_tables;
//   * the vis and stats report steps, because it pulls in
//     rocky8/anadama2/0.10.0-devel (pweave, and the R_LIBS that holds vegan)
//     and R/4.5.1-fasrc01 on top of biobakery_workflows, and HUMAnN for
//     add_ec_names' humann_rename_table.
def env_biobakery  = "${hutlab}; module load rocky8/biobakeryworkflows/3.2"

// HAllA 0.8.20 gets its own module and must not be given biobakeryworkflows/3.2
// as well. HAllA pins numpy<2 (through statsmodels) and checks it with
// pkg_resources.require() before parsing its arguments, but the 3.2 module puts
// assembly_depends -- numpy 2.2.6 -- ahead of depends on PYTHONPATH, because
// the matplotlib in depends is too old for numpy 2 and the report rendering
// needs the newer one. Under 3.2, HAllA therefore aborts immediately with a
// pkg_resources.ContextualVersionConflict. The halla module has its own numpy
// 1.26.4 and its own R_LIBS, and resolves the rpy2 libRblas.so load as well.
def env_halla      = "${hutlab}; module load rocky8/halla/0.8.20"

process {
    executor = 'slurm'
    queue    = 'hsph'

    // ── Read-based profiling ───────────────────────────────────────────────
    // Split per process rather than grouped: base.config groups these two under
    // one selector, and an identical selector here would replace its resources
    // (rule 1).
    withName: single_end_kneaddata                        { beforeScript = env_kneaddata }
    withName: paired_end_kneaddata                        { beforeScript = env_kneaddata }
    withName: 'metaphlan|metaphlan_bzip|metaphlan_merge'  { beforeScript = env_metaphlan }
    // Split for the same reason as the KneadData pair above.
    withName: sample2markers                              { beforeScript = env_metaphlan }
    withName: strainphlan                                 { beforeScript = env_metaphlan }
    withName: kneaddata_read_counts                       { beforeScript = env_kneaddata }

    withName: 'humann|humann_regroup|humann_regroup_ecs|humann_rename|humann_renorm|humann_join|humann_join_relab' {
        beforeScript = env_humann
    }

    withName: 'humann_count_features|humann_feature_counts_merge|rna_dna_norm' {
        beforeScript = env_biobakery
    }

    withName: 'metaphlan_species_counts|humann_log_counts' { beforeScript = env_biobakery }

    withName: humann {
        // 8 rather than base.config's 16: the hsph partition schedules an
        // 8-core job far sooner, and HUMAnN's wall time is dominated by the
        // translated search, which is I/O bound on the uniref database.
        // memory and time are base.config's figures, restated under rule 2.
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = { 12.h  * task.attempt }
    }

    withName: baqlava {
        beforeScript = env_baqlava
        // BAQLaVa runs HUMAnN internally (bacterial depletion plus a DIAMOND
        // translated search), so it needs more than the humann process, not the
        // 16 GB of base.config: at 16 GB it was OOM-killed at a 15.69 GB peak.
        // cpus and time are base.config's figures, restated under rule 2.
        memory = { 48.GB * task.attempt }
        cpus   = { 4   * task.attempt }
        time   = { 8.h * task.attempt }
    }

    // ── Assembly (MAG/SGB) ─────────────────────────────────────────────────
    withName: 'megahit|align_and_depth|metabat2|abundance|checkm2|checkm2_merge|checkm2_wrangling|mag_n50|phylophlan_metagenomic|phylophlan_merge|mash_list_inputs|mash_sketch|mash_paste|mash_dist|sgb_cluster|merge_tax_abundance' {
        beforeScript = env_biobakery
    }

    withName: megahit {
        // 8 rather than 16 for the same scheduling reason as humann: it is
        // memory-bound rather than core-bound here. memory and time are
        // base.config's figures, restated under rule 2.
        cpus   = 8
        memory = { 64.GB * task.attempt }
        time   = { 24.h  * task.attempt }
    }

    withName: phylophlan_metagenomic {
        // 32 GB is enough for the SGB sketch database on this filesystem;
        // base.config's 64 GB is the conservative figure for a cold cache. 8
        // cores for the same scheduling reason as megahit. time is
        // base.config's figure, restated under rule 2.
        memory = { 32.GB * task.attempt }
        cpus   = 8
        time   = { 24.h * task.attempt }
    }

    // ── vis / stats reports ────────────────────────────────────────────────
    withName: 'identify_inputs|feature_table|trim_taxonomy|alpha_diversity|add_ec_names|vis_report|mantel_test|maaslin2|covariate_equation|beta_diversity|permanova|stratified_metadata|stratified_barplot|halla_transpose_metadata|stats_report|archive_output' {
        beforeScript = env_biobakery
    }

    withName: halla {
        // Resources are base.config's figures, restated under rule 2: halla is
        // one process, so there is no non-colliding selector for it.
        beforeScript = env_halla
        cpus         = { 4     * task.attempt }
        memory       = { 16.GB * task.attempt }
        time         = { 4.h   * task.attempt }
    }

    // ── Steps that need no module at all ───────────────────────────────────
    // merge_pairs concatenates two fastq files; stage_report_input and
    // merge_report_input only copy files into a folder layout.

    withName: version_log {
        // Run locally so the process inherits the login-node module
        // environment, and load every tool stack so the version strings it
        // captures are the ones the run actually used. Resources are
        // base.config's figures, restated under rule 2.
        executor     = 'local'
        beforeScript = "${env_kneaddata}; module load gcc/9.5.0-fasrc01; module load rocky8/baqlava/1.2.0-devel"
        cpus         = 1
        memory       = '1.GB'
        time         = '10.m'
    }
}

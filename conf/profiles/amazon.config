// ─────────────────────────────────────────────────────────────────────────────
// SITE RUNTIME — AWS Batch (-profile amazon). INCOMPLETE since v0.0.2.
//
// It configures containers and queues for core profilers and HUMAnN helpers.
// Several QC/taxonomy helpers, assembly and vis/stats have no image or queue.
// BAQLaVa has resources and a queue but no image. Treat this as a starting
// point for an AWS port, not as a working profile.
//
// There are no database paths either: unlike harvard_rc and tufts_hpc this
// profile has no matching conf/databases/ file, so pass --host_genome,
// --metaphlan_db and the HUMAnN references as s3:// paths yourself. The legacy
// MetaPhlAn 3.1 image also needs matching metaphlan_version/index settings.
// Run template: conf/example_yamls/amazon.yaml
//
// The work directory must be given with -w s3://your-bucket/work; it used to be
// hardcoded to a private bucket here.
// ─────────────────────────────────────────────────────────────────────────────

aws.region        = 'us-east-1'
aws.batch.cliPath = '/home/ec2-user/micromamba/bin/aws'

process {
    executor = 'awsbatch'

    withName: 'single_end_kneaddata|paired_end_kneaddata' {
        maxForks  = 4
        memory    = '16.GB'
        time      = '12.h'
        cpus      = 16
        container = 'public.ecr.aws/j5i5h1i5/kneaddata-nodb:mamba-v0.10'
        queue     = 'Nexflow-kneaddata'
    }

    withName: metaphlan {
        maxForks  = 4
        memory    = '8.GB'
        time      = '12.h'
        cpus      = 8
        container = 'public.ecr.aws/j5i5h1i5/metaphlan-nodb:mamba-v3.1'
        queue     = 'Nextflow-metaphlan'
    }

    withName: humann {
        maxForks  = 4
        memory    = '32.GB'
        time      = '24.h'
        cpus      = 16
        container = 'public.ecr.aws/j5i5h1i5/humann-nodb:mamba-v3.7'
        queue     = 'Nextflow-humann'
    }

    withName: 'humann_regroup|humann_rename|humann_renorm|humann_join|humann_join_relab|humann_count_features|humann_feature_counts_merge|rna_dna_norm' {
        maxForks  = 1
        memory    = '16.GB'
        time      = '1.h'
        cpus      = 2
        container = 'public.ecr.aws/j5i5h1i5/humann-nodb:mamba-v3.7'
        queue     = 'Nextflow-IOPS'
    }

    withName: baqlava {
        maxForks  = 4
        memory    = '16.GB'
        time      = '8.h'
        cpus      = 8
        queue     = 'Nextflow-humann'
    }
}

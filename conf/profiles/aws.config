// ─────────────────────────────────────────────────────────────────────────────
// SITE RUNTIME — AWS Batch. INCOMPLETE, and unmaintained since v0.0.2.
//
// It configures containers and queues for the six read-based core processes
// only. The other fifty-odd -- every merge and table step, the whole assembly
// workflow, and all of vis and stats -- have no container here, so they would
// run in whatever image Batch defaults to and almost certainly fail. Treat this
// as a starting point for an AWS port, not as a working profile.
//
// There are no database paths either: unlike harvard_rc and tufts_hpc this
// profile has no matching conf/databases/ file, so pass --host_genome,
// --metaphlan_db and --humann_db as s3:// paths yourself.
//
// The work directory must be given with -w s3://your-bucket/work; it used to be
// hardcoded to a private bucket here.
// ─────────────────────────────────────────────────────────────────────────────

aws.region        = 'us-east-1'
aws.batch.cliPath = '/home/ec2-user/micromamba/bin/aws'

process {
    executor = 'awsbatch'

    withName: 'single_end_kneaddata|paired_end_kneaddata' {
        maxForks  = 4
        memory    = '16.G'
        time      = '12.h'
        cpus      = 16
        container = 'public.ecr.aws/j5i5h1i5/kneaddata-nodb:mamba-v0.10'
        queue     = 'Nexflow-kneaddata'
    }

    withName: metaphlan {
        maxForks  = 4
        memory    = '8.G'
        time      = '12.h'
        cpus      = 8
        container = 'public.ecr.aws/j5i5h1i5/metaphlan-nodb:mamba-v3.1'
        queue     = 'Nextflow-metaphlan'
    }

    withName: metaphlan_bzip {
        maxForks  = 1
        memory    = '8.G'
        time      = '2.h'
        cpus      = 2
        container = 'public.ecr.aws/j5i5h1i5/bzip2:mamba-v1.0.8'
        queue     = 'Nextflow-IOPS'
    }

    withName: humann {
        maxForks  = 4
        memory    = '32.G'
        time      = '24.h'
        cpus      = 16
        container = 'public.ecr.aws/j5i5h1i5/humann-nodb:mamba-v3.7'
        queue     = 'Nextflow-humann'
    }

    withName: 'humann_regroup|humann_regroup_ecs|humann_rename|humann_renorm|humann_join|humann_join_relab|humann_count_features|humann_feature_counts_merge|rna_dna_norm' {
        maxForks  = 1
        memory    = '16.G'
        time      = '1.h'
        cpus      = 2
        container = 'public.ecr.aws/j5i5h1i5/humann-nodb:mamba-v3.7'
        queue     = 'Nextflow-IOPS'
    }

    withName: baqlava {
        maxForks  = 4
        memory    = '16.G'
        time      = '8.h'
        cpus      = 8
        queue     = 'Nextflow-humann'
    }
}

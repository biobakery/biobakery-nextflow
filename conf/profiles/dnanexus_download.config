// DNAnexus — lean images with project references downloaded to worker SSD.
// Build: bash dxbuild.sh --profile dnanexus_download --refresh-images
// References: conf/databases/dnanexus_download.config; see docs/dnanexus.md.
params {
    dnanexus_container = 'public.ecr.aws/j5i5h1i5/kneaddata:0.12.1-nodb-dnanexus-r1'
    dnanexus_metaphlan_container = 'public.ecr.aws/j5i5h1i5/metaphlan:4.2.5-nodb-dnanexus-r1'
    dnanexus_humann_container = 'public.ecr.aws/j5i5h1i5/humann:4.0.0-experimental-nodb-dnanexus-r1'
    dnanexus_baqlava_container = 'public.ecr.aws/j5i5h1i5/baqlava:4.0.0-r1'
    run_strain_profiling = true
    run_viral_profiling = true
    // Null selects the worker's project; override for a separate reference project.
    dnanexus_reference_project = null
    dnanexus_reference_folder = '/Databases'
    dnanexus_reference_diagnostics = true
}

// Preserve Micromamba activation. Cached r1 images still ship a mount entrypoint;
// disable it for analysis tasks and helpers. No FUSE execution is supported.
docker.entrypointOverride = false

process {
    // Shell helpers need the software but no reference mount or credentials.
    containerOptions = '--env DXFUSE_ENABLED=false'

    // HUMAnN's regroup/rename/normalization commands share this mounted task.
    // Keep resource selectors inherited from dnanexus.config and base.config.
    withName: 'single_end_kneaddata|paired_end_kneaddata|metaphlan|humann|strainphlan|baqlava' {
        // Resolve references from each task's actual inputs. In particular, a
        // MetaPhlAn selects its own database; archive mode fetches its whole bundle.
        ext.reference_paths = {
            def stage = task.process.tokenize(':').last()
            if (stage.endsWith('kneaddata')) {
                return reference_db_paths.findAll { it }.collect { [path: it.toString(), type: 'directory'] }
            }
            if (stage == 'metaphlan') {
                return [[path: db.metaphlan_db.toString(), type: 'directory']]
            }
            if (stage == 'strainphlan') {
                def pkl = db.strainphlan_db.toString()
                return [[path: pkl.substring(0, pkl.lastIndexOf('/')), type: 'directory'],
                        [path: pkl, type: 'file']]
            }
            if (stage == 'baqlava') {
                if (!params.dnanexus_baqlava_container)
                    error 'Set dnanexus_baqlava_container to a BAQLaVa software image before enabling viral profiling'
                if (!references.any { it.flag == '--nucdb' } || !references.any { it.flag == '--protdb' })
                    error 'DNAnexus BAQLaVa requires baqlava_db_nucleotide and baqlava_db_protein'
                def refs = references.collect { [path: it.path.toString(), type: it.type] }
                if (!params.baqlava_bypass_depletion) {
                    if (!params.baqlava_depletion_db)
                        error 'Set baqlava_depletion_db to the HUMAnN nucleotide reference configured in the BAQLaVa image, or explicitly bypass depletion'
                }
                return refs.unique()
            }
            def references = [params.humann_db_chocophlan, params.humann_db_protein,
                              params.humann_db_utilitymapping].findAll { it }
                .collect { [path: it.toString(), type: 'directory'] }
            // Container-path custom mappings outside utilitymapping also need
            // staging. Host mappings already arrive as ordinary Nextflow inputs.
            mappings.findAll { it.database_location == 'container' }.each { mapping ->
                if (mapping.group_mapping_database)
                    references << [path: mapping.group_mapping_database.toString(), type: 'file']
                if (params.run_humann_rename && mapping.renaming_database)
                    references << [path: mapping.renaming_database.toString(), type: 'file']
            }
            references.unique()
        }
        // Nextflow runs beforeScript on the worker before entering scratch/Docker.
        // NXF_SCRATCH is already allocated here; stage there, never on the head.
        beforeScript = {
            def quote = { value -> "'" + value.toString().replace("'", "'\"'\"'") + "'" }
            def selected = task.ext.reference_paths.collect { reference ->
                def value = reference.path.toString().replaceAll('/+$', '')
                def prefix = '/Databases/'
                if (!value.startsWith(prefix))
                    error 'Downloaded database paths must be below /Databases/'
                def relative = value.substring(prefix.length())
                if (relative.tokenize('/').any { it in ['.', '..'] })
                    error 'Database paths must not contain . or .. components'
                [path: relative, type: reference.type]
            }.unique()
            // A selected parent already includes any selected child folder.
            def targets = selected.findAll { entry ->
                !selected.any { parent -> parent.type == 'directory' && parent.path != entry.path && entry.path.startsWith(parent.path + '/') }
            }
            def configured_archives = params.dnanexus_reference_archives
            if (!(configured_archives instanceof List))
                error 'dnanexus_reference_archives must be an array; use [] for directory downloads'
            def archives = configured_archives.collect { entry ->
                if (!(entry instanceof Map) || !(entry.archive instanceof String) || !(entry.extract_to instanceof String))
                    error 'Each reference archive requires archive and extract_to strings'
                def archive = entry.archive.replaceAll('/+$', '')
                def destination = entry.extract_to.replaceAll('/+$', '')
                [archive, destination].each { path ->
                    if (!path || path.startsWith('/') || path.tokenize('/').any { it in ['.', '..'] })
                        error 'Reference archive and extraction paths must be relative without . or .. components'
                }
                [archive: archive, extract_to: destination]
            }
            if (archives.collect { it.archive }.unique(false).size() != archives.size())
                error 'Each reference archive must have one extraction mapping'
            archives.eachWithIndex { entry, i ->
                if (archives.take(i).any { other -> entry.extract_to == other.extract_to ||
                    entry.extract_to.startsWith(other.extract_to + '/') || other.extract_to.startsWith(entry.extract_to + '/') })
                    error 'Reference archive extraction directories must not overlap'
            }
            def covered = { reference, archive -> reference.path == archive.extract_to || reference.path.startsWith(archive.extract_to + '/') }
            def needed_archives = archives.findAll { archive -> targets.any { covered(it, archive) } }
            def archive_downloads = needed_archives.collect { archive ->
                def parent = archive.extract_to.contains('/')
                    ? archive.extract_to.substring(0, archive.extract_to.lastIndexOf('/')) : ''
                def checks = selected.findAll { covered(it, archive) }.collect { reference ->
                    def inside = reference.path == archive.extract_to ? '' : reference.path.substring(archive.extract_to.length() + 1)
                    def check = reference.type == 'directory' ? '-d' : '-f'
                    """
                    if ! test ${check} "\$reference_archive_tmp/extracted/"${quote(inside)} || ! test -r "\$reference_archive_tmp/extracted/"${quote(inside)}; then
                        printf '[references] ERROR: archive lacks expected database path: %s\\n' ${quote(reference.path)} >&2
                        exit 74
                    fi
                    """
                }.join('\n')
                """
                reference_archive=${quote(archive.archive)}
                reference_archive_target=${quote(archive.extract_to)}
                reference_archive_tmp=\$(mktemp -d "\$reference_task_root/.reference-archive.XXXXXX")
                reference_archive_started=\$SECONDS
                printf '[references] downloading archive %s:%s/%s\\n' "\$reference_project" "\$reference_folder" "\$reference_archive" | tee -a "\$reference_task_root/.reference-download.log"
                if ! dx download --no-progress "\$reference_project:\$reference_folder/\$reference_archive" --output "\$reference_archive_tmp/reference.tar"; then
                    echo '[references] ERROR: archive download failed; analysis will not start.' >&2
                    exit 74
                fi
                printf '[references] archive download completed in %s seconds\\n' "\$((SECONDS-reference_archive_started))" | tee -a "\$reference_task_root/.reference-download.log"
                reference_extract_started=\$SECONDS
                mkdir -- "\$reference_archive_tmp/extracted"
                if ! tar --extract --file "\$reference_archive_tmp/reference.tar" --directory "\$reference_archive_tmp/extracted" --no-same-owner --no-same-permissions --delay-directory-restore; then
                    echo '[references] ERROR: archive extraction failed; analysis will not start.' >&2
                    exit 74
                fi
                ${checks}
                mkdir -p -- "\$reference_cache/"${quote(parent)}
                test ! -e "\$reference_cache/\$reference_archive_target" || { echo '[references] ERROR: archive destination already exists.' >&2; exit 74; }
                mv -- "\$reference_archive_tmp/extracted" "\$reference_cache/\$reference_archive_target"
                rm -- "\$reference_archive_tmp/reference.tar"
                rmdir -- "\$reference_archive_tmp"
                printf '[references] archive extraction completed in %s seconds; destination=%s\\n' "\$((SECONDS-reference_extract_started))" "\$reference_archive_target" | tee -a "\$reference_task_root/.reference-download.log"
                """
            }.join('\n')
            def downloads = targets.findAll { entry -> !needed_archives.any { covered(entry, it) } }.collect { entry ->
                def relative = entry.path
                def leaf = relative.tokenize('/').last()
                def parent = relative.contains('/') ? relative.substring(0, relative.lastIndexOf('/')) : ''
                def command = entry.type == 'directory'
                    ? 'dx download --recursive --no-progress "$reference_project:$reference_folder/$reference_relative"'
                    : 'dx download --no-progress "$reference_project:$reference_folder/$reference_relative" --output "$reference_leaf"'
                def check = entry.type == 'directory' ? '-d' : '-f'
                """
                reference_relative=${quote(relative)}
                reference_parent=${quote(parent)}
                reference_leaf=${quote(leaf)}
                reference_partial=\$(mktemp -d "\$reference_cache/.download.XXXXXX")
                printf '[references] downloading %s:%s/%s\\n' "\$reference_project" "\$reference_folder" "\$reference_relative"
                if ! (cd "\$reference_partial" && ${command}); then
                    echo '[references] ERROR: project database download failed; analysis will not start.' >&2
                    exit 74
                fi
                test ${check} "\$reference_partial/\$reference_leaf" || { echo '[references] ERROR: downloaded database path is missing.' >&2; exit 74; }
                mkdir -p -- "\$reference_cache/\$reference_parent"
                test ! -e "\$reference_cache/\$reference_relative" || { echo '[references] ERROR: local reference destination already exists.' >&2; exit 74; }
                mv -- "\$reference_partial/\$reference_leaf" "\$reference_cache/\$reference_relative"
                rmdir -- "\$reference_partial"
                """
            }.join('\n')
            """
            reference_project=${params.dnanexus_reference_project ? quote(params.dnanexus_reference_project) : '"\${DX_PROJECT_CONTEXT_ID:-}"'}
            [[ "\$reference_project" =~ ^project-[[:alnum:]]+\$ ]] || { echo '[references] ERROR: set dnanexus_reference_project or provide the worker project context.' >&2; exit 74; }
            command -v dx >/dev/null || { echo '[references] ERROR: the worker dx CLI is missing.' >&2; exit 74; }
            reference_folder=${quote(params.dnanexus_reference_folder.toString().replaceAll('/+$', ''))}
            [[ "\$reference_folder" == /* || -z "\$reference_folder" ]] || { echo '[references] ERROR: project reference folder must be absolute.' >&2; exit 74; }
            reference_task_root="\${NXF_SCRATCH:-\$PWD}"
            reference_cache="\$reference_task_root/.reference-cache/Databases"
            mkdir -p -- "\$reference_cache"
            reference_started=\$SECONDS
            printf '[references] local SSD download started; project=%s folder=%s\\n' "\$reference_project" "\$reference_folder" | tee "\$reference_task_root/.reference-download.log"
            ${needed_archives ? "command -v tar >/dev/null || { echo '[references] ERROR: the worker tar executable is missing.' >&2; exit 74; }" : ''}
            ${archive_downloads}
            ${downloads}
            printf '[references] local SSD download completed in %s seconds\\n' "\$((SECONDS-reference_started))" | tee -a "\$reference_task_root/.reference-download.log"
            """
        }
        // Inserted into .command.sh by the profiling modules, so checks run
        // inside Docker after the image entrypoint, rather than on the host.
        ext.reference_check = {
            def quote = { value -> "'" + value.toString().replace("'", "'\"'\"'") + "'" }
            def checks = task.ext.reference_paths.collect { reference ->
                def path = reference.path
                def kind = reference.type
                def check = kind == 'directory' ? '-d' : '-f'
                """
                printf '[references] database ${kind}: %s\\n' ${quote(path)} >&2
                if ! test ${check} ${quote(path)} || ! test -r ${quote(path)}; then
                    echo '[references] ERROR: database ${kind} missing or unreadable; inspect the project folder and database path settings.' >&2
                    exit 72
                fi
                """
            }.join('\n')
            def details = params.dnanexus_reference_diagnostics ? """
                printf '[references] container image: %s\\n' ${quote(task.container)} >&2
                printf '[references] source project: %s\\n' ${params.dnanexus_reference_project ? quote(params.dnanexus_reference_project) : '"\${DX_PROJECT_CONTEXT_ID:-unset}"'} >&2
                printf '[references] source folder: %s\\n' ${quote(params.dnanexus_reference_folder)} >&2
                ls -ld -- /Databases >&2 || true
                if command -v findmnt >/dev/null 2>&1; then
                    findmnt -T /Databases -o TARGET,FSTYPE >&2 || true
                fi
                """ : ''
            """
            test ! -f .reference-download.log || cat .reference-download.log >&2
            printf '[references] checking local SSD references for %s\\n' ${quote(task.process)} >&2
            ${details}
            ${checks}
            echo '[references] local database directories verified.' >&2
            """
        }
        containerOptions = {
            def quote = { value -> "'" + value.toString().replace("'", "'\"'\"'") + "'" }
            // Cached r1 images expose /Databases through this fixed legacy symlink.
            // BAQLaVa has an ordinary directory. These are read-only local binds.
            def destination = task.process.tokenize(':').last() == 'baqlava'
                ? '/Databases' : '/tmp/dxfuse/Databases'
            '--env DXFUSE_ENABLED=false --volume "$PWD/.reference-cache/Databases":' +
                quote(destination) + ':ro'
        }
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// SITE RUNTIME — this machine. Also the `standard` profile, so a bare
// `nextflow run main.nf` uses it.
//
// Every task runs here, with the resource requests from conf/base.config
// treated as a local core and memory budget. No tool environment and no
// database paths are set, so pass them yourself:
//
//   nextflow run main.nf -profile local --readsdir reads --host_genome /db/hg38 \
//     --metaphlan_db /db/metaphlan --humann_db /db/humann
//
// Lower params.max_cpus / max_memory to match the machine before running a real
// study on it; the defaults (32 cores, 128 GB) are cluster-sized.
// ─────────────────────────────────────────────────────────────────────────────

process {
    executor = 'local'
}

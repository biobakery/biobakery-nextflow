// ─────────────────────────────────────────────────────────────────────────────
// SITE RUNTIME — DNAnexus Nextflow pipeline executable.
//
// Build this repository with `dx build --nextflow` and select this profile at
// runtime. DNAnexus supplies the executor for the head job and its subjobs, so
// do not set `process.executor` here.
//
// This first profile intentionally targets KneadData only. Container selection
// is scoped to the three QC processes so the core workflow remains portable and
// later tools cannot accidentally inherit the KneadData image.
//
// DNAnexus only supports copy-mode publication to relative paths. Every current
// process already uses mode `copy`; nextflow_schema.json constrains `outdir` to
// a relative path for the platform interface.
// ─────────────────────────────────────────────────────────────────────────────

docker {
    enabled = true
}

// DNAnexus documents 5 as the default and 1000 as the upper bound. Fifty keeps
// a study parallel without flooding a project during this initial deployment.
executor {
    queueSize = 50
}

process {
    withName: 'single_end_kneaddata|paired_end_kneaddata' {
        // A full dx://project:file URI is portable across projects. For this
        // same-project pilot, a bare file ID is also accepted and qualified
        // from the DNAnexus head job's project context at task creation time.
        container = {
            if (!params.dnanexus_container) {
                throw new IllegalArgumentException(
                    'The dnanexus profile requires --dnanexus_container with an immutable KneadData image reference.'
                )
            }
            def image = params.dnanexus_container.toString()
            if (image.startsWith('file-')) {
                def project = System.getenv('DX_PROJECT_CONTEXT_ID')
                if (!project) {
                    throw new IllegalArgumentException(
                        'A bare DNAnexus container file ID can only be resolved inside a DNAnexus job; use dx://project-id:file-id elsewhere.'
                    )
                }
                return "dx://${project}:${image}"
            }
            image
        }
        // dxfuse runs in the task wrapper. Mounting below the task work
        // directory makes the database visible at the same path when Nextflow
        // starts the container. These permissions are DNAnexus-only.
        containerOptions = '--device /dev/fuse --cap-add SYS_ADMIN --env DX_SECURITY_CONTEXT --env DX_APISERVER_HOST --env DX_APISERVER_PORT --env DX_APISERVER_PROTOCOL --env DX_PROJECT_CONTEXT_ID'
        beforeScript = 'dnanexus_mount_kneaddata project-JBVGpB00Kg1xBf54v05BXj6f /Databases/kneaddata hg37dec_v0.1'
        afterScript  = 'dnanexus_unmount_kneaddata'
    }

    withName: kneaddata_read_counts {
        container = params.dnanexus_container
    }
}

// Defaults for the first, intentionally narrow DNAnexus vertical slice.
params {
    workflow                  = 'mgx'
    outdir                    = 'results'
    dnanexus_container        = 'dx://project-JBVGpB00Kg1xBf54v05BXj6f:file-JBpK39Q0Kg1x9BZVK6J0gbfZ'
    host_genome               = 'dx://project-JBVGpB00Kg1xBf54v05BXj6f:/Databases/kneaddata/'
    kneaddata_reference_mode  = 'dxfuse'
    kneaddata_database_identity = 'hg37dec_v0.1:file-JBpJzkj0Kg1x9BZVK6J0gZBy,file-JBpJzkj0Kg1x0yJKB0774vbB,file-JBpJzkj0Kg1x9BZVK6J0gZBv,file-JBpJzkj0Kg1XVj5pG9Q3qBFv,file-JBpJzkj0Kg1YX85x63ggpQ2K,file-JBpJzkj0Kg1VBFZzzPyJ7gP4'
    run_qc                    = true
    stop_after_qc             = true
    run_taxonomic_profiling   = false
    run_functional_profiling  = false
    run_vis                   = false
    run_stats                 = false
    run_strain_profiling      = false
    run_viral_profiling       = false
    log_versions              = false
}

// DNAnexus — execution environment and process instances.
// Reference: https://documentation.dnanexus.com/user/running-apps-and-workflows/running-nextflow-pipelines
// References: conf/databases/dnanexus.config
// Run selections: conf/example_yamls/dnanexus.yaml
// Build with dxbuild.sh using the existing project image cache.
// Populate/update image caches with dxbuild.sh --refresh-images. DNAnexus supplies the executor.
// Run KneadData, MetaPhlAn and HUMAnN; reporting remains disabled.

params {
    dnanexus_container = 'public.ecr.aws/j5i5h1i5/kneaddata:latest-hg37dec'
    dnanexus_metaphlan_container = 'public.ecr.aws/j5i5h1i5/metaphlan:4.2.5-mpa_vOct22_202403'
    dnanexus_humann_container = 'public.ecr.aws/j5i5h1i5/humann:experimental'
    reporting_root = '/opt/workflow'
    // Leave stats_viz_container unset until its dedicated image is available.
    // nextflow inspect discovers even disabled processes during cache builds.
    run_qc = true
    stop_after_qc = false
    run_taxonomic_profiling = true
    run_functional_profiling = true
    humann_version = 'humann_v4a'
    run_humann_regroup = true
    run_humann_rename = true
    run_humann_merge = true
    // Use the verified mapping files inside the HUMAnN image. Relative names
    // resolve against humann_db_utilitymapping without staging host files.
    humann_regroups = [
        [output_label: 'ecs', group_mapping_database: 'map_level4ec_uniclust90.txt.gz', renaming_database: 'map_level4ec_name.txt.gz'],
        [output_label: 'kos', group_mapping_database: 'map_ko_uniref90.txt.gz', renaming_database: 'map_ko_name.txt.gz'],
        [output_label: 'pfams', group_mapping_database: 'map_pfam_uniref90.txt.gz', renaming_database: 'map_pfam_name.txt.gz']
    ]
    run_viral_profiling = false
    run_strain_profiling = false
    run_vis = false
    run_stats = false
    log_versions = false
}

docker {
    enabled = true
    runOptions = '-u $(id -u):$(id -g)'
}

executor.queueSize = 50

process {
    // Covers every process, including shell helpers and the optional QC gate.
    // Explicit machineType selects the subjob instance, not the head job.
    // Use the instance selected for this organization's initial deployment.
    container = { params.dnanexus_container }
    machineType = 'mem3_ssd2_v3_x16'
    cpus = 2
    memory = '6.GB'

    withName: 'single_end_kneaddata|paired_end_kneaddata|kneaddata_read_counts|baqlava|sample2markers|strainphlan' {
        container = { params.dnanexus_container }
    }
    withName: 'metaphlan|metaphlan_bzip|metaphlan_merge' {
        container = { params.dnanexus_metaphlan_container }
    }
    withName: 'humann|humann_regroup|humann_rename|humann_renorm|humann_join|humann_join_relab|humann_count_features|humann_feature_counts_merge|humann_log_counts|rna_dna_norm' {
        container = { params.dnanexus_humann_container }
    }
    withLabel: stats_viz {
        container = { params.stats_viz_container }
    }

    // Eight threads for QC and the other analysis tools. Extra SSD space
    // accommodates the database-bearing images and read intermediates.
    withName: 'single_end_kneaddata|paired_end_kneaddata|baqlava|sample2markers|strainphlan|align_and_depth|abundance|metabat2|checkm2' {
        cpus = 8
        memory = '28.GB'
    }

    // These workers have sixteen cores; forward all of them to the profilers.
    withName: 'metaphlan|humann' {
        cpus = 16
        memory = '28.GB'
    }

    // Instance assignments cover assembly too; its images and references
    // still need site-specific configuration, as on Hopper.
    withName: 'megahit|phylophlan_metagenomic' {
        cpus = 16
        memory = '56.GB'
    }

    withName: 'humann_regroup|humann_rename|humann_renorm|humann_join|humann_join_relab|humann_count_features|humann_feature_counts_merge|rna_dna_norm|checkm2_merge|checkm2_wrangling|mag_n50|phylophlan_merge|mash_list_inputs|mash_sketch|mash_paste|mash_dist|sgb_cluster|merge_tax_abundance|halla' {
        cpus = 4
        memory = '14.GB'
    }

    withName: 'alpha_diversity|mantel_test|maaslin2|beta_diversity|permanova|stratified_barplot' {
        cpus = 2
        memory = '14.GB'
        time = '2.h'
    }

    withName: 'vis_report|stats_report' {
        cpus = 4
        memory = '28.GB'
        time = '6.h'
    }

    withName: 'identify_inputs|feature_table|trim_taxonomy|add_ec_names|covariate_equation|stratified_metadata|halla_transpose_metadata|archive_output|kneaddata_read_counts|metaphlan_bzip|metaphlan_merge|metaphlan_species_counts|humann_log_counts|stage_report_input|merge_report_input|merge_pairs' {
        cpus = 1
        memory = '6.GB'
    }

    withName: version_log {
        cpus = 1
        memory = '1.GB'
        time = '10.m'
    }

    // Fixed task limits stay within the pinned instances on every retry.
    // conf/base.config still supplies time limits and retry policy.
}

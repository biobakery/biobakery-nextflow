// ─────────────────────────────────────────────────────────────────────────────
// SITE RUNTIME — Tufts HPC, SLURM + Apptainer.
//
// Resource requests come from conf/base.config. Up to v0.0.4 this file repeated
// most of them at values that had drifted a copy behind, so the numbers are
// gone rather than kept: base.config is sized from real execution traces, and
// a site should override it only where this cluster genuinely differs.
//
// Add such an override below, with the reason, in the form base.config uses:
//
//     withName: humann {
//         // the batch partition caps a job at 8 cores
//         cpus = 8
//     }
//
// Unlike harvard_rc, nothing here sets a per-process software environment: the
// tools are expected to be on PATH, or supplied by a container. Database paths
// are in conf/databases/tufts.config.
// ─────────────────────────────────────────────────────────────────────────────

process {
    executor = 'slurm'
    queue    = 'batch'
}

apptainer {
    enabled    = true
    autoMounts = true
    runOptions = '--no-home --bind /cluster'
}

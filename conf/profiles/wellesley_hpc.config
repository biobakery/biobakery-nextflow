// Wellesley HPC — SLURM day-long-cpu partition + local Apptainer images.
// References: conf/databases/wellesley_hpc.config
// Run template: conf/example_yamls/wellesley_hpc.yaml
// Partial environment: BAQLaVa, assembly and reports need additional software.
apptainer {
    enabled = true
    autoMounts = true
}

process {
    executor = 'slurm'
    queue    = 'day-long-cpu'

    withName: 'single_end_kneaddata|paired_end_kneaddata' {
        container = '/home/gz101/containers/kneaddata.sif'
        memory = '16.GB'
        time   = '8.h'
        cpus   = 20
    }

    withName: metaphlan {
        container = '/home/gz101/containers/metaphlan.sif'
        memory = '32.GB'
        time   = '4.h'
        cpus   = 20
    }

    withName: metaphlan_merge {
        // merge_metaphlan_tables.py uses the same image as profiling.
        container = '/home/gz101/containers/metaphlan.sif'
        memory = '8.GB'
        time   = '1.h'
        cpus   = 1
    }

    withName: humann {
        // Profiling and its table utilities must share the same environment.
        container = '/home/gz101/containers/humann.sif'
        memory = '32.GB'
        time   = '12.h'
        cpus   = 20
    }

    withName: 'humann_regroup|humann_rename|humann_renorm|humann_join|humann_join_relab|humann_count_features|humann_feature_counts_merge|humann_log_counts|rna_dna_norm' {
        container = '/home/gz101/containers/humann.sif'
        memory = '16.GB'
        time   = '2.h'
        cpus   = 2
    }

    withName: baqlava {
        // Supply a site BAQLaVa container or PATH environment before enabling.
        // BAQLaVa runs HUMAnN internally (bacterial depletion + DIAMOND
        // translated search), so it needs at least as much memory as the humann
        // process above. At 16 GB it was OOM-killed at a 15.69 GB peak.
        memory = { 48.GB * task.attempt }
        time   = { 8.h   * task.attempt }
        cpus   = 4
    }

    withName: strainphlan {
        container = '/home/gz101/containers/metaphlan.sif'
        memory = '16.GB'
        time   = '8.h'
        cpus   = 8
    }

    withName: 'single_end_kneaddata|paired_end_kneaddata|kneaddata_read_counts' {
        container = '/home/gz101/containers/kneaddata.sif'
    }

    withName: version_log {
        // Preserve login-host logging; restate resources to retain the base budget.
        executor = 'local'
        cpus     = 1
        memory   = '1.GB'
        time     = '10.m'
    }

}

// Optional full run, after these database-free images are published and the
// selected references are present in the project. Uses the same local staging.
params {
    dnanexus_metaphlan_container = 'public.ecr.aws/j5i5h1i5/metaphlan:4.2.5-nodb-dnanexus-r1'
    dnanexus_humann_container = 'public.ecr.aws/j5i5h1i5/humann:4.0.0-experimental-nodb-dnanexus-r1'
    dnanexus_baqlava_container = 'public.ecr.aws/j5i5h1i5/baqlava:4.0.0-r1'
    run_taxonomic_profiling = true
    run_functional_profiling = true
    run_strain_profiling = true
    run_viral_profiling = true
    baqlava_db_nucleotide = '/Databases/baqlava/BAQLaVa_v05/BAQLaVa.V0.5.nucleotide'
    baqlava_db_protein = '/Databases/baqlava/BAQLaVa_v05/BAQLaVa.V0.5.protein'
    baqlava_depletion_db = '/Databases/humann/chocophlan-v4-201901/chocophlan'
    baqlava_depletion_protein_db = '/Databases/humann/chocophlan-v4-201901/uniref90_annotated'
    baqlava_depletion_mapping_db = '/Databases/humann/chocophlan-v4-201901/full_mapping'
    // MetaPhlAn/StrainPhlAn use the corrected extracted project indexes, not
    // the older bundled-image archive containing duplicate viral references.
    // HUMAnN and BAQLaVa share this layout, downloaded once per allocation.
    dnanexus_reference_archives = [
        [archive: 'tarballs/chocophlan-v4-201901.tar.gz', extract_to: 'humann/chocophlan-v4-201901']
    ]
}

// Wellesley Hopper — execution environment only.
// References: conf/databases/wellesley_hopper.config
// Run selections: conf/wellesley_hopper.yaml

docker {
    enabled = true
    // Keep the repository layout visible at the paths used by projectDir.
    // Mount helper subdirectories rather than the root so work/ and results/
    // remain writable, and avoid duplicating Nextflow's automatic bin/ mount.
    runOptions = '-u $(id -u):$(id -g)' +
        " -v '${projectDir}/bin/scripts:${projectDir}/bin/scripts:ro'" +
        " -v '${projectDir}/bin/lib:${projectDir}/bin/lib:ro'" +
        " -v '${projectDir}/bin/Rscripts:${projectDir}/bin/Rscripts:ro'" +
        " -v '${projectDir}/assets:${projectDir}/assets:ro'"
}

params.stats_viz_container = 'biobakery-stats-viz:0.0.4'
params.reporting_root = '/opt/workflow'

process {
    executor = 'local'

    withName: 'single_end_kneaddata|paired_end_kneaddata|kneaddata_read_counts' {
        container = 'kneaddata:latest-hg37dec'
        cpus   = 8
    }

    withName: 'metaphlan|metaphlan_bzip|metaphlan_merge' {
        container = 'metaphlan:latest-mpa_vOct22_202403'
        cpus   = 8
    }
    
    withName: 'humann|humann_regroup|humann_rename|humann_renorm|humann_join|humann_join_relab' {
        container = 'humann:experimental'
        cpus   = 8
    }

    withName: 'rna_dna_norm' {
        container = 'humann:experimental'
        cpus   = 8
    }

    withName: baqlava {
        container = 'kneaddata:latest-hg37dec'
        cpus   = 8
    }

    withName: 'sample2markers|strainphlan' {
        container = 'kneaddata:latest-hg37dec'
        cpus   = 8
    }

    withName: version_log {
        executor     = 'local'
        cpus   = 8
    }

}

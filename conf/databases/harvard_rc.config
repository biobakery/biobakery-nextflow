// ─────────────────────────────────────────────────────────────────────────────
// SITE DEFAULTS — Harvard FASRC (Cannon) database paths.
//
// Selected by -profile harvard_rc, together with conf/profiles/harvard_rc.config.
// These are defaults, not fixtures: override any of them on the command line,
// e.g. --host_genome /n/lab_storage/huttenhower_lab/data/kneaddata_databases/mouse_C57BL
//
// The two *_version values live here rather than in conf/params.config because
// they are properties of these databases, not preferences: the index a database
// was built for decides which tool build can read it.
//
// This stack is deliberate and interlocking. MetaPhlAn 4.0.6_vOct22 with
// mpa_vOct22_CHOCOPhlAnSGB_202403 is what HUMAnN 4 and BAQLaVa 1.2.0 are
// compatible with; HUMAnN 4 cannot yet read the vJan25 database, and
// metaphlan_4/4.2 is python3.12 and conflicts with the python3.10 stack the
// profile loads. See docs/dependencies.md before changing any one of them.
// ─────────────────────────────────────────────────────────────────────────────

params {
    // KneadData. The lab default host is human (hg38); mouse_C57BL is alongside it.
    host_genome        = '/n/lab_storage/huttenhower_lab/data/kneaddata_databases/hg38'
    // Metatranscriptome QC (mtx, and the mtx half of mgx_mtx) additionally
    // removes host mRNA and SILVA rRNA, as wmgx_wmtx.py does for its wts half.
    host_transcriptome = '/n/lab_storage/huttenhower_lab/data/kneaddata_databases/transcriptome'
    rrna_db            = '/n/lab_storage/huttenhower_lab/data/kneaddata_databases/ribosomal_RNA/SILVA_128_LSUParc_SSUParc_ribosomal_RNA_v0.2'

    // MetaPhlAn. metaphlan_4.0.6_fixed selects the v3-style --bowtie2db /
    // --bowtie2out flags, which is what this build expects.
    metaphlan_db       = '/n/lab_storage/huttenhower_lab/tools/metaphlan4/rocky8/v4.0.6_vOct_fixed/lib/python3.10/site-packages/metaphlan/metaphlan_databases'
    metaphlan_index    = 'mpa_vOct22_CHOCOPhlAnSGB_202403'
    metaphlan_version  = 'metaphlan_4.0.6_fixed'

    // HUMAnN 4. The path is a folder of symlinks; the pipeline appends
    // /chocophlan, /uniref and /utility_mapping to it.
    humann_db          = '/n/lab_storage/huttenhower_lab/tools/nextflow/databases/humann4'
    humann_version     = 'humann_v4a'

    // Resolved from metaphlan_db and from the bundled BAQLaVa database.
    strainphlan_db     = null
    baqlava_db         = null

    // Assembly (MAG/SGB). checkm2 locates its own database through the
    // CHECKM2DB variable exported by rocky8/biobakeryworkflows/3.2, so only the
    // PhyloPhlAn database folder needs naming here.
    phylophlan_path    = '/n/lab_storage/huttenhower_lab/tools/biobakery_workflows/biobakery_workflows_databases/phylophlan'
}

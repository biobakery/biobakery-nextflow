// Wellesley Hopper — reference locations only.
// HUMAnN paths refer to databases bundled inside humann:experimental.
// Run selections belong in conf/example_yamls/wellesley_hopper.yaml.
params {
    // KneadData/HUMAnN references are bundled; MetaPhlAn/BAQLaVa use host paths.
    // Assembly references remain host-provided until configured for Hopper.
    kneaddata_db_location = 'container'
    metaphlan_db_location = 'host'
    humann_db_location = 'container'
    strainphlan_db_location = 'host'
    // The BAQLaVa image is database-free. Nextflow stages and mounts the local
    // viral reference paths supplied in the run YAML.
    baqlava_db_location = 'host'
    baqlava_db_nucleotide = '/murray/databases/baqlava/BAQLaVa_v05/BAQLaVa.V0.5.nucleotide'
    baqlava_db_protein = '/murray/databases/baqlava/BAQLaVa_v05/BAQLaVa.V0.5.protein'
    // Full HUMAnN references for BAQLaVa's internal bacterial-depletion run.
    // The runtime profile mounts these at the full paths in the image's config.
    baqlava_depletion_db = '/murray/databases/humann/chocophlan-v4-201901/chocophlan'
    baqlava_depletion_protein_db = '/murray/databases/humann/chocophlan-v4-201901/uniref90_annotated'
    baqlava_depletion_mapping_db = '/murray/databases/humann/chocophlan-v4-201901/full_mapping'
    phylophlan_db_location = 'host'
    checkm2_db_location = 'host'
    host_genome = '/Databases/kneaddata/hg37dec'
    metaphlan_db_root = '/murray/databases/metaphlan/mpa_vOct22_202403'
    // A profile-only run uses the primary reference; YAML can select both.
    metaphlan_db = '/murray/databases/metaphlan/mpa_vOct22_202403/mpa_vOct22_202403_default'
    metaphlan_index = 'mpa_vOct22_CHOCOPhlAnSGB_202403'
    metaphlan_version = 'metaphlan_v4'
    humann_db_chocophlan = '/Databases/humann/chocophlan-v4-201901/chocophlan'
    humann_db_utilitymapping = '/Databases/humann/chocophlan-v4-201901/full_mapping'
    humann_db_protein = '/Databases/humann/chocophlan-v4-201901/uniref90_annotated'
    humann_version = 'humann_v4a'
}

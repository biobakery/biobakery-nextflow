// ─────────────────────────────────────────────────────────────────────────────
// SITE DEFAULTS — Tufts HPC database paths (Bonham Lab shared storage).
//
// Selected by -profile tufts_hpc. Override any of them on the command line.
//
// This is the HUMAnN 3.7 stack: MetaPhlAn 4 with mpa_vJun23_CHOCOPhlAnSGB_202307
// and the HUMAnN 3 databases. It is a different, also self-consistent pairing
// to the Harvard one -- do not mix values between the two files.
// ─────────────────────────────────────────────────────────────────────────────

params {
    host_genome       = '/cluster/tufts/bonhamlab/shared/databases/kneaddata/hg38'

    metaphlan_db      = '/cluster/tufts/bonhamlab/shared/databases/metaphlan'
    metaphlan_index   = 'mpa_vJun23_CHOCOPhlAnSGB_202307'
    metaphlan_version = 'metaphlan_v4'

    humann_db         = '/cluster/tufts/bonhamlab/shared/databases/humann3'
    humann_version    = 'humann_v37'

    strainphlan_db    = null
    baqlava_db        = null

    // Metatranscriptome QC and the assembly workflow need these; set them to
    // run --workflow mtx, mgx_mtx or assembly here.
    host_transcriptome = null
    rrna_db            = null
    phylophlan_path    = null
}

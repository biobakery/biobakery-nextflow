// Wellesley HPC — host references for the local Apptainer images.
// Runtime: conf/profiles/wellesley_hpc.config
// Override any value on the CLI: --host_genome /path/to/other/db
params {
    // Host/contaminant reference for KneadData: human hg37dec.
    host_genome      = '/home/gz101/Databases/kneaddata/hg37dec_v0.1'
    metaphlan_databases = [[
        metaphlan_db: '/home/gz101/Databases/metaphlan4/mpa_vOct22_lon_subsp',
        metaphlan_index: 'mpa_vOct22_CHOCOPhlAnSGB_202403_lon_subsp',
        metaphlan_version: 'metaphlan_v4'
    ]]
    humann_db_chocophlan = '/home/gz101/Databases/humann4/chocophlan'
    humann_db_utilitymapping = '/home/gz101/Databases/humann4/utility_mapping'
    humann_db_protein = '/home/gz101/Databases/humann4/uniref'
    humann_version    = 'humann_v4a'
    strainphlan_db    = null             // auto-resolved from metaphlan_db
    baqlava_db        = null
    // Metatranscriptome and assembly references are not configured here.
    host_transcriptome = null
    rrna_db            = null
    phylophlan_path    = null
}

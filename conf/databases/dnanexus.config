// DNAnexus — reference locations inside the same database-bearing images as Hopper.
// Registry copies of those images must retain these internal paths.
// Run selections belong in conf/example_yamls/dnanexus.yaml.
params {
    // Read-based references are bundled in their tool images.
    // Assembly references remain host-provided until configured for Hopper.
    kneaddata_db_location = 'container'
    metaphlan_db_location = 'container'
    humann_db_location = 'container'
    strainphlan_db_location = 'container'
    baqlava_db_location = 'container'
    phylophlan_db_location = 'host'
    checkm2_db_location = 'host'
    host_genome = '/Databases/kneaddata/hg37dec'
    metaphlan_db_root = '/Databases/metaphlan/mpa_vOct22_202403'
    // Default applet runs use the primary index without requiring a params YAML.
    // The optional YAML selects both bundled Hopper reference variants.
    metaphlan_db = '/Databases/metaphlan/mpa_vOct22_202403/mpa_vOct22_202403_default'
    metaphlan_index = 'mpa_vOct22_CHOCOPhlAnSGB_202403'
    metaphlan_version = 'metaphlan_v4'
    humann_db_chocophlan = '/Databases/humann/chocophlan-v4-201901/chocophlan'
    humann_db_utilitymapping = '/Databases/humann/chocophlan-v4-201901/full_mapping'
    humann_db_protein = '/Databases/humann/chocophlan-v4-201901/uniref90_annotated'
}

// Minimal core MGX example: Docker + SLURM.
// Edit the shared root, partition/account, and database directories.
// For local execution: set executor = 'local' and remove queue/clusterOptions.
def bb_root = '/shared/YOUR_GROUP/biobakery'

docker {
    enabled = true
    runOptions = '-u $(id -u):$(id -g) --env DXFUSE_ENABLED=false' +
        " --volume ${bb_root}:${bb_root}"
}

params {
    max_cpus = 16
    max_memory = '64.GB'
    max_time = '24.h'
    kneaddata_db_location = 'host'
    metaphlan_db_location = 'host'
    humann_db_location = 'host'

    // Replace directory placeholders with the actual installer output paths.
    host_genome = "${bb_root}/databases/kneaddata/HOST_INDEX_DIRECTORY"
    metaphlan_db_root = "${bb_root}/databases/metaphlan"
    metaphlan_db = "${bb_root}/databases/metaphlan/mpa_vOct22_202403"
    metaphlan_index = 'mpa_vOct22_CHOCOPhlAnSGB_202403'
    metaphlan_version = 'metaphlan_v4'
    humann_db_chocophlan = "${bb_root}/databases/humann/CHOCOPHLAN_DIRECTORY"
    humann_db_protein = "${bb_root}/databases/humann/UNIREF_DIRECTORY"
    humann_db_utilitymapping = "${bb_root}/databases/humann/MAPPING_DIRECTORY"
    humann_version = 'humann_v4a'
}

process {
    executor = 'slurm'
    queue = 'YOUR_PARTITION'
    // clusterOptions = '--account=YOUR_ACCOUNT'

    withName: 'single_end_kneaddata|paired_end_kneaddata|kneaddata_read_counts' {
        container = 'public.ecr.aws/klepac-ceraj-lab/kneaddata:0.12.1-nodb-dnanexus-r1'
    }

    withName: 'metaphlan|metaphlan_merge' {
        container = 'public.ecr.aws/klepac-ceraj-lab/metaphlan:4.2.5-nodb-dnanexus-r1'
    }

    withName: 'humann|humann_join|humann_regroup|humann_rename|humann_renorm|humann_join_relab|humann_count_features|humann_feature_counts_merge|humann_log_counts|rna_dna_norm' {
        container = 'public.ecr.aws/klepac-ceraj-lab/humann:4.0.0-experimental-nodb-dnanexus-r1'
    }
}

executor.queueSize = 4

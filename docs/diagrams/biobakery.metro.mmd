%% Curated workflow overview. Detailed process DAGs are generated by bin/make_diagrams.py.
%%metro title: bioBakery / Nextflow
%%metro style: nfcore
%%metro legend: 24,410
%%metro compact_offsets: true
%%metro font_scale: 1.15
%%metro fold_threshold: 16
%%metro line: profile | Taxonomy & function | #3984C6
%%metro line: strain | Strains (optional) | #18A999 | dashed
%%metro line: viral | Viruses (mgx, optional) | #E58C40 | dashed
%%metro line: expression | Paired DNA/RNA (mgx_mtx) | #9B72CF
%%metro line: assembly | MAG assembly | #C49A32
%%metro line: reports | Visualization & statistics | #D45F8C
%%metro files: reads | FASTQ | DNA / RNA reads
%%metro file: tables | TSV | Genes & pathways
%%metro file: trees | TREE | Phylogenies
%%metro file: viruses | TSV | Viral profiles
%%metro file: ratios | TSV | Ratios
%%metro dir: mags | MAGs | Genomes & SGBs
%%metro file: metadata | TSV | Study metadata
%%metro off_track: metadata
%%metro file: vis_report | HTML | vis
%%metro file: stats_report | HTML | stats
%%metro marker: associations | square, open
%%metro marker_legend: square, open | Opt-in statistics; requires metadata

graph LR
    subgraph qc [Read preparation]
        reads[ ]
        kneaddata[KneadData]
        reads -->|profile,strain,viral,expression,assembly| kneaddata
    end

    subgraph taxonomy [Taxonomy / mgx, mtx]
        metaphlan[MetaPhlAn]
    end

    subgraph function [Function / mgx, mtx]
        humann[HUMAnN]
        tables[ ]
        humann -->|profile,expression| tables
    end

    subgraph strains [Strain profiling]
        strainphlan[StrainPhlAn]
        trees[ ]
        strainphlan -->|strain| trees
    end

    subgraph viral [Viral profiling / mgx]
        baqlava[BAQLaVa]
        viruses[ ]
        baqlava -->|viral| viruses
    end

    subgraph expression [Paired DNA/RNA / mgx_mtx]
        rna_dna_norm[RNA/DNA ratio]
        ratios[ ]
        rna_dna_norm -->|expression| ratios
    end

    subgraph assembly [MAG assembly]
        megahit[MEGAHIT]
        metabat2[Align + bin]
        placement[Quality + placement]
        sgb_cluster[Mash + SGB clustering]
        mags[ ]
        megahit -->|assembly| metabat2
        metabat2 -->|assembly| placement
        placement -->|assembly| sgb_cluster
        sgb_cluster -->|assembly| mags
    end

    subgraph reports [Reports / vis, stats]
        diversity[Diversity + plots]
        associations[MaAsLin2 + HAllA]
        metadata[ ]
        vis_report[ ]
        stats_report[ ]
        diversity -->|reports| vis_report
        metadata -->|reports| associations
        associations -->|reports| stats_report
    end

    kneaddata -->|profile,strain,viral,expression| metaphlan
    kneaddata -->|assembly| megahit
    metaphlan -->|profile,expression| humann
    metaphlan -->|strain| strainphlan
    metaphlan -->|viral| baqlava
    tables -->|expression| rna_dna_norm
    tables -->|reports| diversity
    tables -->|reports| associations

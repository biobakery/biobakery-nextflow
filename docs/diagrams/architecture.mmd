        MGX("<b>MGX</b><br/><i>--workflow mgx</i><br/>Whole Metagenome Shotgun (MGX)<br/>workflow<br/><i>wires 6 stages:</i><br/>· QUALITY_CONTROL<br/>· TAXONOMIC_PROFILING<br/>· FUNCTIONAL_PROFILING<br/>· VIRAL_PROFILING<br/>· STRAIN_PROFILING<br/>· REPORTING<br/><i>+ 3 steps of its own</i>")
        MGX_MTX("<b>MGX_MTX</b><br/><i>--workflow mgx_mtx</i><br/>Paired whole metagenome +<br/>metatranscriptome workflow.<br/><i>wires 5 stages:</i><br/>· QUALITY_CONTROL<br/>· TAXONOMIC_PROFILING<br/>· FUNCTIONAL_PROFILING<br/>· STRAIN_PROFILING<br/>· REPORTING<br/><i>+ 5 steps of its own</i>")
        MTX("<b>MTX</b><br/><i>--workflow mtx</i><br/>Whole Metatranscriptome (MTX)<br/>workflow.<br/><i>wires 5 stages:</i><br/>· QUALITY_CONTROL<br/>· TAXONOMIC_PROFILING<br/>· FUNCTIONAL_PROFILING<br/>· STRAIN_PROFILING<br/>· REPORTING<br/><i>+ 3 steps of its own</i>")
        STATS("<b>STATS</b><br/><i>--workflow stats</i><br/>Statistics workflow — the Nextflow<br/>port of biobakery_workflows stats.<br/><i>+ 14 steps of its own</i>")
        VIS("<b>VIS</b><br/><i>--workflow vis</i><br/>Visualization workflow — the<br/>Nextflow port of biobakery_workflows<br/>vis.<br/><i>+ 7 steps of its own</i>")
    end
    subgraph L3["3 · STAGES — subworkflows/*.nf"]
        direction TB
        QUALITY_CONTROL("<b>QUALITY_CONTROL</b><br/>Quality control subworkflow: host<br/>decontamination + trimming via<br/>KneadData<br/><i>called by:</i> ASSEMBLY, MGX, MGX_MTX,<br/>MTX<br/><i>3 steps from 1 module</i>")
        TAXONOMIC_PROFILING("<b>TAXONOMIC_PROFILING</b><br/>Taxonomic profiling subworkflow:<br/>MetaPhlAn per sample + merged table<br/><i>called by:</i> MGX, MGX_MTX, MTX<br/><i>4 steps from 1 module</i>")
        FUNCTIONAL_PROFILING("<b>FUNCTIONAL_PROFILING</b><br/>Functional profiling subworkflow:<br/>HUMAnN, then the three feature types<br/><i>called by:</i> MGX, MGX_MTX, MTX<br/><i>10 steps from 5 modules</i>")
        VIRAL_PROFILING("<b>VIRAL_PROFILING</b><br/>Viral profiling subworkflow: BAQLaVa<br/><i>called by:</i> MGX<br/><i>1 step from 1 module</i>")
        STRAIN_PROFILING("<b>STRAIN_PROFILING</b><br/>Strain profiling subworkflow:<br/>StrainPhlAn SGB-level<br/><i>called by:</i> MGX, MGX_MTX, MTX<br/><i>2 steps from 1 module</i>")
        REPORTING("<b>REPORTING</b><br/>Run vis and/or stats at the end of a<br/>read-based workflow.<br/><i>called by:</i> MGX, MGX_MTX, MTX<br/><i>chains back into:</i> STATS + VIS")
        mtx_common["<b>mtx_common.nf</b> — <i>helper, not a stage</i><br/>The KneadData reference database set for<br/>metatranscriptome reads.<br/><i>called by:</i> MGX_MTX, MTX"]
